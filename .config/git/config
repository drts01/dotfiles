[alias]
	amend = "commit --amend --no-edit"
	echo = "!echo $@"
	fixup = "!git log -n 10 --pretty=format:'%h %s' --no-merges | fzf | cut -c -7 | xargs -o git commit --fixup #"
	fix = "!git log -n 10 --pretty=format:'%h %s' --no-merges | fzf | cut -c -7 | xargs -o git commit --fixup $(for P in $@; do printf ${GIT_PREFIX:-.}${P}' '; done) #"
	stat = "status --short --branch --show-stash --ahead-behind"
	l = "log --color --graph --pretty=format:'%C(dim magenta)%h%Creset - %s %C(dim green)(%cr) %C(reset blue)<%an>%Creset%C(yellow)%d%Creset' --abbrev-commit"
	lmsg = "log --pretty=format:'* %s'"
	wd = diff --word-diff=color --word-diff-regex='[^[:space:]]'

[advice]
	detachedHead = false
	skippedCherryPicks = false

[color]
	ui = true

[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold
	whitespace = red reverse

[core]
	attributesfile = ~/.config/git/attributes
	pager = less -RFX
	# editor = nvim || vim || vi

[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

[diff]
	tool = smartdiff
	relative = true

[diff "exif"]
	textconv = exiftool || file $0

[difftool]
	prompt = false

[difftool "smartdiff"]
	cmd = nvim -d "$LOCAL" "$REMOTE" || vimdiff || diff --color --context 3 "$LOCAL" "$REMOTE"

[init]
	defaultBranch = trunk

[interactive]
	diffFilter = pygmentize -l diff || cat

[merge]
    conflictstyle = zdiff3
	tool = smartmerge

[mergetool "smartmerge"]
	cmd = nvim -d "$LOCAL" "$REMOTE" || vimdiff || diff --color --context 3 "$LOCAL" "$REMOTE"

[pull]
	rebase = true

[push]
	default = current
	autoSetupRemote = true

[rebase]
	autoStash = true
	autosquash = true

[user]
	name = Carlos Meza
	email = carlos@digitalr00ts.com

[includeIf "gitdir/:~/git/github/"]
	path = ~/git/github/.gitconfig

[includeIf "gitdir:~/git/UHG/"]
	path = ~/git/UHG/.gitconfig
