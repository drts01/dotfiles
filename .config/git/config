[alias]
	amend = "commit --amend --no-edit"
	echo = "!echo $@"
	fixup = "!git log -n 10 --pretty=format:'%h %s' --no-merges | fzf | cut -c -7 | xargs -o git commit --fixup #"
	fix = "!git log -n 10 --pretty=format:'%h %s' --no-merges | fzf | cut -c -7 | xargs -o git commit --fixup $(for P in $@; do printf ${GIT_PREFIX:-.}${P}' '; done) #"
	stat = "status --short --branch --show-stash --ahead-behind"
	l = "log -10 --color --graph --pretty=format:'%C(dim magenta)%h%Creset - %s %C(dim green)(%cr) %C(reset blue)<%an>%Creset%C(yellow)%d%Creset' --abbrev-commit"
	lmsg = "log --pretty=format:'* %s'"
	wd = diff --word-diff=color --word-diff-regex='[^[:space:]]'
	diff-side = -c delta.side-by-side=true diff

[advice]
	detachedHead = false
	skippedCherryPicks = false

[color]
	ui = true

[core]
	attributesfile = ~/.config/git/attributes
	pager = "if command -v delta >/dev/null 2>&1; then delta; elif command -v bat >/dev/null 2>&1; then bat; else less -RFX; fi"

[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

[delta]
	features =  diff-so-fancy
	file-decoration-style = ul yellow
	hunk-header-decoration-style = none
	line-numbers = true
	navigate = true
	hyperlinks = true
	syntax-theme = Dracula
	grep-match-line-style = syntax bold auto
	grep-context-line-style = syntax auto

[diff]
	colorMoved = default
	relative = true
	tool = smartdiff

[diff "exif"]
	textconv = exiftool || file $0

[difftool]
	prompt = false

[difftool "smartdiff"]
	cmd = "if command -v nvim >/dev/null 2>&1; then nvim -d \"$LOCAL\" \"$REMOTE\"; elif command -v vim >/dev/null 2>&1; then vim -d \"$LOCAL\" \"$REMOTE\"; else diff --color --context 3 "$LOCAL" "$REMOTE" fi"

[extensions]
	objectFormat = sha256
	compatObjectFormat = sha1

[grep]
	lineNumber = true
	column = true

[init]
	defaultBranch = trunk
	defaultObjectFormat = sha256

[interactive]
	diffFilter = "if command -v delta >/dev/null 2>&1; then delta --color-only; elif command -v bat >/dev/null 2>&1; then bat; else internal; fi"

[merge]
	conflictstyle = zdiff3
	tool = smartmerge

[mergetool "smartmerge"]
	cmd = "if command -v nvim >/dev/null 2>&1; then nvim -d -c \"wincmd J\" \"$MERGED\" \"$LOCAL\" \"$REMOTE\"; elif command -v vim >/dev/null 2>&1; then vim -d -c \"wincmd J\" \"$MERGED\" \"$LOCAL\" \"$REMOTE\"; else diff --color --context 3 "$LOCAL" "$REMOTE";fi"

[pull]
	rebase = true

[push]
	default = current
	autoSetupRemote = true
	recurseSubmodules = check

[rebase]
	autoStash = true
	autosquash = true

[user]
	name = Carlos Meza
	email = carlos@digitalr00ts.com

[includeIf "gitdir/:~/git/github/"]
	path = ~/git/github/.gitconfig

[includeIf "gitdir:~/git/UHG/"]
	path = ~/git/UHG/.gitconfig
