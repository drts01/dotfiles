# Stop execution here for non-interactive tasks (prevents scp/rsync/cron errors)
case "$-" in
  *i*) : ;;
*) return 0 2> /dev/null || exit 0 ;;
esac

SH_CONF="$XDG_CONFIG_HOME/sh"
. "$SH_CONF/profile.d/10_functions.sh"
. "$SH_CONF/sh.d/20_aliases.sh"


if [ "$_shell" = "sh" ] && [ -z "$ZELLIJ" ] && [ "$TERM_PROGRAM" != "zellij" ] && has zellij; then
  zellij attach -c default || zellij
fi
