# shellcheck shell=sh

# Stop execution here for non-interactive tasks (prevents scp/rsync/cron errors)
case "$-" in
  *i*) : ;;
*) return 0 2> /dev/null || exit 0 ;;
esac

SH_CONF="$XDG_CONFIG_HOME/sh"
. "$SH_CONF/profile.d/10_functions.sh"

for file in "$SH_CONF"/sh.d/*.sh; do
  case "$_shell:$file" in
    zsh:*/30_search.sh|zsh:*/40_tools.sh) ;;  # Defer until Zsh completion is ready
    *) # shellcheck disable=SC1090
       . "$file" ;;
  esac
done
unset file
