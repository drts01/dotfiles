" Plugin-free fallback settings support Vim 8+; optional packages may need newer Vim.
set nocompatible
set encoding=utf-8
let mapleader = ','

" Explicit paths also support older Vim launched through VIMINIT or -u.
let s:config = fnamemodify(resolve(expand('<sfile>:p')), ':h')
execute 'set runtimepath^=' . escape(s:config, ' ,\')
execute 'set runtimepath+=' . escape(s:config . '/after', ' ,\')
execute 'set packpath^=' . escape(s:config, ' ,\')

if has('termguicolors')
  set termguicolors
endif
set cursorline number relativenumber
set showmode laststatus=2 nowrap
set statusline=%<%f\ %h%m%r%=%y\ %l:%c\ %P
set list listchars=tab:▷⋅,trail:⋅,nbsp:⋅
set splitbelow splitright hidden
set wildmode=longest:full,full wildmenu
set wildignore=*.o,*.obj,*~,*.pyc,*.swp
set hlsearch incsearch ignorecase smartcase
set autoindent tabstop=4 softtabstop=4 shiftwidth=4 noexpandtab
set backspace=indent,eol,start
set showmatch history=1000
set signcolumn=yes
set lazyredraw updatetime=300
set scrolloff=8 sidescrolloff=8
set noerrorbells novisualbell
set t_vb=
set timeoutlen=500
if has('mouse')
  set mouse=a
endif

" Keep recovery data private and out of the deployed configuration tree.
let s:state = (empty($XDG_STATE_HOME) ? expand('~/.local/state') : $XDG_STATE_HOME) . '/vim'
set backup
try
  for s:kind in ['backup', 'swap', 'undo']
    if !isdirectory(s:state . '/' . s:kind)
      call mkdir(s:state . '/' . s:kind, 'p', 0700)
    endif
  endfor
  let &backupdir = escape(s:state . '/backup', ',') . '//'
  let &directory = escape(s:state . '/swap', ',') . '//'
  if has('persistent_undo')
    let &undodir = escape(s:state . '/undo', ',') . '//'
    set undofile undolevels=10000
  endif
catch
  echohl WarningMsg
  echomsg 'Vim recovery directory unavailable: ' . v:exception
  echohl None
endtry

nnoremap <F5> :buffers<CR>:buffer<Space>
nnoremap Q gq
nnoremap <silent> <leader><space> :nohlsearch<CR>
nnoremap <leader>w :write<CR>
nnoremap <leader>q :quit<CR>
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l
" Browsing remains available when no packages are initialized.
nnoremap <leader>n :Explore<CR>

function! s:StripTrailingWhitespace() abort
  if &filetype ==# 'markdown' || &buftype !=# '' || !&modifiable
    return
  endif
  let l:view = winsaveview()
  try
    keepjumps keeppatterns %s/\s\+$//e
  finally
    call winrestview(l:view)
  endtry
endfunction

augroup dotfiles_vim
  autocmd!
  autocmd BufWritePre * call <SID>StripTrailingWhitespace()
augroup END

" Configure packages before Vim loads their startup scripts.
let g:lightline = {'colorscheme': 'wombat'}
let g:gitgutter_highlight_lines = 0
let g:gitgutter_sign_priority = 5
let g:gitgutter_sign_allow_clobber = 0
let g:ale_sign_priority = 10
let g:ale_sign_error = '✗'
let g:ale_sign_warning = '⚠'
let g:ale_linters_explicit = 1
" A separate, opt-in LSP client owns language-server processes.
let g:ale_disable_lsp = 1
let g:ale_linters = {'python': ['ruff'], 'sh': ['shellcheck']}
let g:ale_fixers = {'python': ['ruff', 'ruff_format'], 'sh': ['shfmt']}
let g:ale_fix_on_save = 0
let g:fzf_vim = {'preview_window': ['right,50%', 'ctrl-/']}

" Filetype defaults must run before EditorConfig applies project overrides.
filetype plugin indent on

" Prefer the bundled implementation rather than loading two EditorConfig copies.
if !empty(globpath(&packpath, 'pack/*/opt/editorconfig/plugin/editorconfig.vim'))
  packadd editorconfig
elseif filereadable(s:config . '/pack/plugins/opt/editorconfig-vim/plugin/editorconfig.vim')
  packadd editorconfig-vim
endif

function! s:ConfigurePackages() abort
  if exists('g:loaded_lightline')
    set noshowmode
  endif
  if has('patch-8.2.5136') && filereadable(s:config . '/pack/plugins/opt/vim-fern/plugin/fern.vim')
    packadd vim-fern
    nnoremap <silent> <leader>n :Fern . -drawer -toggle -reveal=%<CR>
  endif
  if exists(':Files') == 2 && exists('*fzf#run') && executable('fzf')
    nnoremap <silent> <C-p> :Files<CR>
    nnoremap <silent> <leader>b :Buffers<CR>
    if executable('rg')
      nnoremap <silent> <leader>f :Rg<CR>
    endif
  endif
  if exists(':ALEInfo') == 2
    nmap <silent> [e <Plug>(ale_previous_wrap)
    nmap <silent> ]e <Plug>(ale_next_wrap)
    nnoremap <silent> <leader>a :ALEFix<CR>
  endif
endfunction

augroup dotfiles_vim_packages
  autocmd!
  autocmd VimEnter * call <SID>ConfigurePackages()
augroup END
if v:vim_did_enter
  call s:ConfigurePackages()
endif

syntax on
set background=dark
silent! colorscheme desert
highlight Search ctermbg=yellow ctermfg=black guibg=yellow guifg=black
highlight IncSearch ctermbg=green ctermfg=black guibg=green guifg=black
