// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "edit_predictions": {
    "provider": "copilot"
  },
  "auto_update": false,
  "cli_default_open_behavior": "existing_window",
  "ui_font_size": 14.0,
  "buffer_font_size": 12.0,
  "markdown_preview": {

  },
  "agent_buffer_font_size": 12.0,
  "agent": {
    "default_model": {
      "provider": "openai-subscribed",
      "model": "gpt-5.6-terra",
      "enable_thinking": true,
      "effort": "low"
    },
    "default_profile": "write",
    "play_sound_when_agent_done": "when_hidden",
    "threads_sidebar": {
      "position": "right"
    },
    "dock": "right",
    "button": true,
    "favorite_models": [],
    "model_parameters": [],
    "tool_permissions": {
      "default": "confirm",
      "tools": {
        "terminal": {
          "default": "confirm",
          "always_allow": [
            { "pattern": "^cargo\\s+(build|test|check|run)" },
            { "pattern": "^npm\\s+(install|test|run|ci)" },
            { "pattern": "^git\\s+.*\\s+(status|diff|log|branch)" },
            { "pattern": "^ls(\\s+.*)?$" },
            { "pattern": "^cat\\s+.*$" },
            { "pattern": "^grep\\s+.*$" }
          ],
          "always_confirm": [
            { "pattern": "sudo\\s+" },
            { "pattern": "rm\\s+-rf" }
          ]
        }
      }
    },
  },
  "collaboration_panel": {
    "button": false
  },
  "git_panel": {
    "dock": "left",
    "starts_open": false
  },
  "outline_panel": {
    "dock": "left",
    "multi_buffer_hide_symbols": false
  },
  "terminal": {
    "font_size": 11.0,
    "show_count_badge": false
  },
  "use_system_window_tabs": false,
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false
  },
  "tabs": {
    "file_icons": false,
    "git_status": false
  },
  "title_bar": {
    "button_layout": "platform_default"
  },
  "project_panel": {
    "dock": "left",
    "hide_hidden": false,
    "bold_folder_labels": false,
    "hide_root": false,
    "git_status_indicator": true,
    "entry_spacing": "standard",
    "button": true
  },
  "autosave": "on_focus_change",
  "vim_mode": false,
  "helix_mode": true,
  "session": {
    "trust_all_worktrees": true
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    }
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Dracula",
  },
  "lsp": {
    "ryl": {
      "command": "ryl",
      "arguments": ["server"]
    },
    "tombi": {
      "command": "tombi",
      "arguments": ["server"]
    },
    "rumdl": {
      "command": "rumdl",
      "arguments": ["server"]
    }
  },
  "languages": {
    "TOML": {
      "language_servers": ["tombi"],
      "formatter": {
        "language_server": {
          "name": "tombi"
        }
      }
    },
    "Markdown": {
      "language_servers": ["rumdl", "..."],
      "formatter": {
        "language_server": {
          "name": "rumdl"
        }
      }
    },
    "YAML": {
      "language_servers": ["ryl", "..."],
      "formatter": {
        "language_server": {
          "name": "ryl"
        }
      }
    }
  }
}
