// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "accessible_mode": false,
  "edit_predictions": {
    "provider": "copilot"
  },
  "auto_update": false,
  "cli_default_open_behavior": "existing_window",
  "ui_font_size": 14.0,
  "buffer_font_size": 12.0,
  "markdown_preview": {

  },
  "agent_buffer_font_size": 12.0,
  "agent": {
    "auto_compact": {
      "threshold": "90%",
      "enabled": true
    },
    "terminal_init_command": "",
    "sandbox_permissions": {
      "allow_unsandboxed": true
    },
    "profiles": {
      "write": {
        "name": "Write",
        "tools": {
          "copy_path": true,
          "create_directory": true,
          "create_thread": true,
          "delete_path": true,
          "diagnostics": true,
          "apply_code_action": true,
          "ask_user": true,
          "edit_file": true,
          "write_file": true,
          "fetch": true,
          "find_path": true,
          "find_references": true,
          "get_code_actions": true,
          "go_to_definition": true,
          "list_agents_and_models": true,
          "list_directory": true,
          "move_path": true,
          "rename_symbol": true,
          "read_file": true,
          "grep": true,
          "skill": true,
          "spawn_agent": true,
          "terminal": true,
          "search_web": true
        },
        "enable_all_context_servers": true,
        "context_servers": {}
      }
    },
    "thinking_display": "preview",
    "default_model": {
      "effort": "medium",
      "provider": "openai-subscribed",
      "model": "gpt-6-sol",
      "enable_thinking": true
    },
    "default_profile": "write",
    "play_sound_when_agent_done": "when_hidden",
    "threads_sidebar": {
      "position": "right"
    },
    "dock": "right",
    "button": true,
    "favorite_models": [
      {
        "provider": "openai-subscribed",
        "model": "gpt-5.6-sol",
        "enable_thinking": true,
        "effort": "medium"
      },
      {
        "provider": "openai-subscribed",
        "model": "gpt-5.6-terra",
        "enable_thinking": true,
        "effort": "high"
      },
      {
        "provider": "openai",
        "model": "gpt-6-luna",
        "enable_thinking": true,
        "effort": "medium"
      },
      {
        "provider": "copilot_chat",
        "model": "claude-opus-5.5",
        "enable_thinking": true,
        "effort": "medium"
      },
      {
        "provider": "copilot_chat",
        "model": "claude-sonnet-5.5",
        "enable_thinking": true,
        "effort": "high"
      },
      {
        "provider": "copilot_chat",
        "model": "claude-haiku-5.5",
        "enable_thinking": true,
        "effort": "high"
      },
      {
        "provider": "openai-subscribed",
        "model": "gpt-6-sol",
        "enable_thinking": true,
        "effort": "medium"
      },
      {
        "provider": "openai-subscribed",
        "model": "gpt-6-luna",
        "enable_thinking": true,
        "effort": "medium"
      }
    ],
    "model_parameters": [],
    "tool_permissions": {
      "default": "confirm",
      "tools": {
        "fetch": {
          "always_allow": [
            {
              "pattern": "^https?://api\\.github\\.com"
            },
            {
              "pattern": "^https?://raw\\.githubusercontent\\.com"
            },
            {
              "pattern": "^https?://mise\\.jdx\\.dev"
            },
            {
              "pattern": "^https?://docs\\.renovatebot\\.com"
            },
            {
              "pattern": "^https?://floci\\.io"
            },
            {
              "pattern": "^https?://registry\\.terraform\\.io"
            },
            {
              "pattern": "^https?://docs\\.prismacloud\\.io"
            },
            {
              "pattern": "^https?://github\\.com"
            },
            {
              "pattern": "^https?://pypi\\.org"
            },
            {
              "pattern": "^https?://docs\\.ansible\\.com"
            },
            {
              "pattern": "^https?://galaxy\\.ansible\\.com"
            },
            {
              "pattern": "^https?://zensical\\.org"
            },
            {
              "pattern": "^https?://www\\.updatecli\\.io"
            },
            {
              "pattern": "^https?://docs\\.astral\\.sh"
            },
            {
              "pattern": "^https?://docs\\.github\\.com"
            },
            {
              "pattern": "^https?://trivy\\.dev"
            },
            {
              "pattern": "^https?://docs\\.zizmor\\.sh"
            },
            {
              "pattern": "^https?://docs\\.gitlab\\.com"
            },
            {
              "pattern": "^https?://docs\\.docker\\.com"
            },
            {
              "pattern": "^https?://learn\\.microsoft\\.com"
            },
            {
              "pattern": "^https?://docs\\.aws\\.amazon\\.com"
            },
            {
              "pattern": "^https?://www\\.chainguard\\.dev"
            },
            {
              "pattern": "^https?://tekton\\.dev"
            },
            {
              "pattern": "^https?://docs\\.drone\\.io"
            },
            {
              "pattern": "^https?://git-scm\\.com"
            },
            {
              "pattern": "^https?://trufflesecurity\\.com"
            },
            {
              "pattern": "^https?://pre-commit\\.com"
            },
            {
              "pattern": "^https?://www\\.trufflesecurity\\.com"
            },
            {
              "pattern": "^https?://docs\\.python\\.org"
            },
            {
              "pattern": "^https?://docs\\.pydantic\\.dev"
            }
          ]
        },
        "terminal": {
          "default": "confirm",
          "always_allow": [
            {
              "pattern": "^cargo\\s+(build|test|check|run)"
            },
            {
              "pattern": "^npm\\s+(install|test|run|ci)"
            },
            {
              "pattern": "^git\\s+(?:(?:--no-pager|--no-optional-locks)\\s+)*(?:status|diff|log|show|ls-files|describe|check-ignore|ls-remote|blame|rev-list|rev-parse)(?:\\s|$)"
            },
            {
              "pattern": "^(cat|echo|printf|ls|grep|stat|test|find|sort|head|tail|rg|fd|true|command|du|df|wc)(\\s+.*)?$"
            },
            {
              "pattern": "ansible-playbook\\s+.*--syntax-check\\s+"
            },
            {
              "pattern": "ansible-lint\\s+"
            },
            {
              "pattern": "pre(k|-commit)\\s+(run|list|validate-config|validate-manifest)\\s+"
            },
            {
              "pattern": "(podman|docker)\\s+image\\s+inspect\\s+"
            },
            {
              "pattern": "mise\\s+.*run\\s+.*(lint|precommit|fmt|format|check|test|verify|validate|docs)"
            },
            {
              "pattern": "mise\\s+(task|run)"
            },
            {
              "pattern": "(podman|docker)(-|\\s+).*(ps|compose|ls|list|inspect|logs|info)"
            },
            {
              "pattern": "(opentofu|terraform)\\s+.*(show|plan|version|output|fmt)"
            },
            {
              "pattern": "terraform-docs\\s+"
            },
            {
              "pattern": "(jq|yq)\\s+"
            },
            {
              "pattern": "uv\\s+(lock|run|tree|build|audit)\\s+"
            },
            {
              "pattern": "(ruff|pytest)\\s+"
            },
            {
              "pattern": "^gh\\s+run(\\s|$)"
            },
            {
              "pattern": "^sed\\b"
            },
            {
              "pattern": "^sed\\s+s/x1b\\[\\[0-9(\\s|$)"
            },
            {
              "pattern": "^gh\\s+api(\\s|$)"
            },
            { "pattern": "actionlint\\s+"}
          ],
          "always_confirm": [
            { "pattern": "sudo\\s+" },
            { "pattern": "rm\\s+-rf" }
          ]
        }
      }
    },
  },
  "collaboration_panel": {
    "button": false
  },
  "git_panel": {
    "dock": "left",
    "starts_open": false
  },
  "outline_panel": {
    "dock": "left",
    "multi_buffer_hide_symbols": false
  },
  "terminal": {
    "font_size": 11.0,
    "show_count_badge": false
  },
  "use_system_window_tabs": false,
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false
  },
  "tabs": {
    "file_icons": false,
    "git_status": false
  },
  "title_bar": {
    "button_layout": "platform_default"
  },
  "project_panel": {
    "dock": "left",
    "hide_hidden": false,
    "bold_folder_labels": false,
    "hide_root": false,
    "git_status_indicator": true,
    "entry_spacing": "standard",
    "button": true
  },
  "autosave": "on_focus_change",
  "helix_mode": true,
  "session": {
    "trust_all_worktrees": true
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    }
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Dracula",
  },
  "languages": {
    "TOML": {
      "language_servers": ["tombi", "!taplo", "..."],
      "formatter": {
        "language_server": {
          "name": "tombi"
        }
      }
    },
    "Markdown": {
      "language_servers": ["rumdl", "harper-ls", "!codebook", "..."],
      "formatter": {
        "language_server": {
          "name": "rumdl"
        }
      }
    },
    "YAML": {
      "formatter": {
        "external": {
          "command": "ryl",
          "arguments": ["format", "--no-warnings", "--stdin-filename", "{buffer_path}", "-"]
        }
      }
    }
  },
}
