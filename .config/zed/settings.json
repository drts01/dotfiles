// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "accessible_mode": false,
  "edit_predictions": {
    "provider": "copilot"
  },
  "auto_update": false,
  "cli_default_open_behavior": "existing_window",
  "ui_font_size": 14.0,
  "buffer_font_size": 12.0,
  "markdown_preview": {

  },
  "agent_buffer_font_size": 12.0,
  "agent": {
    "auto_compact": {
      "threshold": "90%",
      "enabled": true
    },
    "terminal_init_command": "",
    "sandbox_permissions": {
      "allow_unsandboxed": false
    },
    "profiles": {
      "write": {
        "name": "Write",
        "tools": {
          "copy_path": true,
          "create_directory": true,
          "create_thread": true,
          "delete_path": true,
          "diagnostics": true,
          "apply_code_action": true,
          "ask_user": true,
          "edit_file": true,
          "write_file": true,
          "fetch": true,
          "find_path": true,
          "find_references": true,
          "get_code_actions": true,
          "go_to_definition": true,
          "list_agents_and_models": true,
          "list_directory": true,
          "move_path": true,
          "rename_symbol": true,
          "read_file": true,
          "grep": true,
          "skill": true,
          "spawn_agent": true,
          "terminal": true,
          "search_web": true
        },
        "enable_all_context_servers": true,
        "context_servers": {}
      }
    },
    "thinking_display": "preview",
    "default_model": {
      "effort": "medium",
      "provider": "openai-subscribed",
      "model": "gpt-6-sol",
      "enable_thinking": true
    },
    "default_profile": "write",
    "play_sound_when_agent_done": "when_hidden",
    "threads_sidebar": {
      "position": "right"
    },
    "dock": "right",
    "button": true,
    "favorite_models": [
      {
        "provider": "openai-subscribed",
        "model": "gpt-5.6-sol",
        "enable_thinking": true,
        "effort": "medium"
      },
      {
        "provider": "openai-subscribed",
        "model": "gpt-5.6-terra",
        "enable_thinking": true,
        "effort": "high"
      },
      {
        "provider": "openai",
        "model": "gpt-6-luna",
        "enable_thinking": true,
        "effort": "medium"
      },
      {
        "provider": "copilot_chat",
        "model": "claude-opus-5.5",
        "enable_thinking": true,
        "effort": "medium"
      },
      {
        "provider": "copilot_chat",
        "model": "claude-sonnet-5.5",
        "enable_thinking": true,
        "effort": "high"
      },
      {
        "provider": "copilot_chat",
        "model": "claude-haiku-5.5",
        "enable_thinking": true,
        "effort": "high"
      },
      {
        "provider": "openai-subscribed",
        "model": "gpt-6-sol",
        "enable_thinking": true,
        "effort": "medium"
      },
      {
        "provider": "openai-subscribed",
        "model": "gpt-6-luna",
        "enable_thinking": true,
        "effort": "medium"
      }
    ],
    "model_parameters": [],
    "tool_permissions": {
      "default": "confirm",
      "tools": {
        "fetch": {
          "always_allow": [
            {
              "pattern": "^https?://(?:api\\.github\\.com|raw\\.githubusercontent\\.com|mise\\.jdx\\.dev|docs\\.renovatebot\\.com|floci\\.io|registry\\.terraform\\.io|docs\\.prismacloud\\.io|github\\.com|pypi\\.org|docs\\.ansible\\.com|galaxy\\.ansible\\.com|zensical\\.org|www\\.updatecli\\.io|docs\\.astral\\.sh|docs\\.github\\.com|trivy\\.dev|docs\\.zizmor\\.sh|docs\\.gitlab\\.com|docs\\.docker\\.com|learn\\.microsoft\\.com|docs\\.aws\\.amazon\\.com|www\\.chainguard\\.dev|tekton\\.dev|docs\\.drone\\.io|git-scm\\.com|trufflesecurity\\.com|pre-commit\\.com|www\\.trufflesecurity\\.com|docs\\.python\\.org|docs\\.pydantic\\.dev)(?:[/:?#]|$)"
            }
          ]
        },
        "terminal": {
          "default": "confirm",
          "always_allow": [
            { "pattern": "^git(?: --no-optional-locks)? status(?: --(?:short|branch|porcelain=v1))?\\z" },
            { "pattern": "^git --no-pager diff(?: --check| --no-ext-diff --no-textconv(?: --(?:stat|name-only|name-status))?)\\z" },
            { "pattern": "^git --no-pager log(?: -n [1-9][0-9]{0,2})?(?: --(?:oneline|stat))?\\z" },
            { "pattern": "^git --no-pager show --no-ext-diff --no-textconv(?: --stat)?(?: HEAD)?\\z" },
            { "pattern": "^git branch --(?:show-current|list)\\z" },
            { "pattern": "^git rev-parse --(?:show-toplevel|is-inside-work-tree|abbrev-ref HEAD)\\z" },
            { "pattern": "^git ls-files(?: --others --exclude-standard)?\\z" },
            { "pattern": "^git (?:describe --always|--version)\\z" },
            { "pattern": "^(?:pwd|whoami|id|date|uptime)\\z" },
            { "pattern": "^uname(?: -a)?\\z" },
            { "pattern": "^ls(?: -(?:a|l|la|al))?(?: [A-Za-z0-9_./][A-Za-z0-9_./-]*)?\\z" },
            { "pattern": "^df(?: -h)?\\z" },
            { "pattern": "^du -sh [A-Za-z0-9_./][A-Za-z0-9_./-]*\\z" },
            { "pattern": "^wc -l [A-Za-z0-9_./][A-Za-z0-9_./-]*\\z" },
            { "pattern": "^rg --files(?: [A-Za-z0-9_./][A-Za-z0-9_./-]*)?\\z" },
            { "pattern": "^rg -n -F -- [A-Za-z0-9_][A-Za-z0-9_./:-]*(?: [A-Za-z0-9_./][A-Za-z0-9_./-]*)?\\z" },
            { "pattern": "^fd --type [fd](?: [A-Za-z0-9_./][A-Za-z0-9_./-]*)?(?: [A-Za-z0-9_./][A-Za-z0-9_./-]*)?\\z" },
            { "pattern": "^eza(?: -(?:l|a|la|al))?(?: [A-Za-z0-9_./][A-Za-z0-9_./-]*)?\\z" },
            { "pattern": "^bat --paging=never [A-Za-z0-9_./][A-Za-z0-9_./-]*\\z" },
            { "pattern": "^grep -n -F -- [A-Za-z0-9_][A-Za-z0-9_./:-]* [A-Za-z0-9_./][A-Za-z0-9_./-]*\\z" },
            { "pattern": "^sed -n '[1-9][0-9]{0,3}(?:,[1-9][0-9]{0,3})?p' [A-Za-z0-9_./][A-Za-z0-9_./-]*\\z" },
            { "pattern": "^awk 'END \\{print NR\\}' [A-Za-z0-9_./][A-Za-z0-9_./-]*\\z" },
            { "pattern": "^find [A-Za-z0-9_./][A-Za-z0-9_./-]* -type [fd]\\z" },
            { "pattern": "^(?:head|tail) -n [1-9][0-9]{0,2} [A-Za-z0-9_./][A-Za-z0-9_./-]*\\z" },
            { "pattern": "^test -(?:e|f|d|r) [A-Za-z0-9_./][A-Za-z0-9_./-]*\\z" },
            { "pattern": "^echo(?: [A-Za-z0-9_./][A-Za-z0-9_./-]*)*\\z" },
            { "pattern": "^printf %s [A-Za-z0-9_./][A-Za-z0-9_./-]*\\z" },
            { "pattern": "^true\\z" },
            { "pattern": "^command -v [A-Za-z][A-Za-z0-9_-]*\\z" },
            { "pattern": "^(?:jq|yq)(?: --version| '(?:\\.|keys|length|type)' [A-Za-z0-9_./][A-Za-z0-9_./-]*)\\z" },
            { "pattern": "^uv (?:--version|pip list|pip show [A-Za-z0-9][A-Za-z0-9_.-]*|python list --only-installed|cache dir|tree --frozen --offline --no-build --no-python-downloads)\\z" },
            { "pattern": "^ruff check --no-fix(?: [A-Za-z0-9_./][A-Za-z0-9_./-]*)?\\z" },
            { "pattern": "^ruff format --check(?: [A-Za-z0-9_./][A-Za-z0-9_./-]*)?\\z" },
            { "pattern": "^ty check(?: [A-Za-z0-9_./][A-Za-z0-9_./-]*)?\\z" },
            { "pattern": "^rumdl check --no-code-block-tools(?: [A-Za-z0-9_./][A-Za-z0-9_./-]*)?\\z" },
            { "pattern": "^tombi (?:lint --offline|format --check --offline)(?: [A-Za-z0-9_./][A-Za-z0-9_./-]*)?\\z" },
            { "pattern": "^ryl check [A-Za-z0-9_./][A-Za-z0-9_./-]*\\z" },
            { "pattern": "^python(?:3(?:\\.[0-9]+)?)? (?:-V|--version)\\z" },
            { "pattern": "^(?:pytest|python(?:3(?:\\.[0-9]+)?)? -m pytest)(?: --(?:version|help)|(?: (?:-q|-v|-x|--collect-only|--maxfail=[1-9][0-9]?)){0,4}(?: [A-Za-z0-9_./][A-Za-z0-9_./:-]*)?)\\z" },
            { "pattern": "^(?:pre-commit|prek)(?: --version| validate-(?:config|manifest)(?: [A-Za-z0-9_./][A-Za-z0-9_./-]*)?)\\z" },
            { "pattern": "^prek(?: -c [A-Za-z0-9_./][A-Za-z0-9_./-]*)? list(?: --output-format json)?\\z" },
            { "pattern": "^prek(?: -c [A-Za-z0-9_./][A-Za-z0-9_./-]*)? run(?: --all-files)? --dry-run\\z" },
            { "pattern": "^(?:pre-commit|prek)(?: -c [A-Za-z0-9_./][A-Za-z0-9_./-]*)? run (?:shellcheck|check-json5?|check-yaml|check-toml|check-merge-conflict)(?: --all-files)?\\z" },
            { "pattern": "^tox --no-provision list(?: -d)?\\z" },
            { "pattern": "^tox(?: run)? -e (?:lint|test|tests|unit|py[0-9]{2,3})\\z" },
            { "pattern": "^tox --version\\z" },
            { "pattern": "^gh workflow list(?: --all)?\\z" },
            { "pattern": "^gh workflow view [A-Za-z0-9_./][A-Za-z0-9_./-]*(?: --yaml)?\\z" },
            { "pattern": "^gh run list\\z" },
            { "pattern": "^gh run view [0-9]+\\z" },
            { "pattern": "^gh --version\\z" },
            { "pattern": "^mise (?:--version|ls(?: --(?:current|installed|missing|json))?|tasks ls(?: --(?:json|name-only))?|tasks info [A-Za-z0-9_][A-Za-z0-9_:-]*|config ls)\\z" },
            { "pattern": "^mise run (?:test|check|verify|validate|shell:test)\\z" },
            { "pattern": "^(?:podman|docker)(?: --version| version| info| ps(?: -a)?| images(?: -a)?| container ls(?: -a)?| image ls(?: -a)?| volume ls| network ls| system df(?: -v)?| stats --no-stream(?: --all)?| port [A-Za-z0-9_][A-Za-z0-9_.-]*)\\z" },
            { "pattern": "^podman (?:machine ls|pod ls|system connection list)\\z" },
            { "pattern": "^npm (?:--version|ls --depth=0|root|prefix|run|pkg get (?:name|version|scripts)(?: (?:name|version|scripts))?|config get registry|explain [A-Za-z0-9_@][A-Za-z0-9_@./-]*)\\z" }
          ],
          "always_confirm": [
            { "pattern": "sudo\\s+" },
            { "pattern": "rm\\s+-rf" }
          ]
        }
      }
    },
  },
  "collaboration_panel": {
    "button": false
  },
  "git_panel": {
    "dock": "left",
    "starts_open": false
  },
  "outline_panel": {
    "dock": "left",
    "multi_buffer_hide_symbols": false
  },
  "terminal": {
    "font_size": 11.0,
    "show_count_badge": false
  },
  "use_system_window_tabs": false,
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false
  },
  "tabs": {
    "file_icons": false,
    "git_status": false
  },
  "title_bar": {
    "button_layout": "platform_default"
  },
  "project_panel": {
    "dock": "left",
    "hide_hidden": false,
    "bold_folder_labels": false,
    "hide_root": false,
    "git_status_indicator": true,
    "entry_spacing": "standard",
    "button": true
  },
  "autosave": "on_focus_change",
  "helix_mode": true,
  "session": {
    "trust_all_worktrees": false
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    }
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Dracula",
  },
  "languages": {
    "TOML": {
      "format_on_save": "on",
      "language_servers": ["tombi", "!taplo", "..."],
      "formatter": {
        "language_server": {
          "name": "tombi"
        }
      }
    },
    "Markdown": {
      "format_on_save": "on",
      "language_servers": ["rumdl", "harper-ls", "!codebook", "..."],
      "formatter": {
        "language_server": {
          "name": "rumdl"
        }
      }
    },
    "YAML": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "ryl",
          "arguments": ["format", "--no-warnings", "--stdin-filename", "{buffer_path}", "-"]
        }
      }
    }
  },
}
